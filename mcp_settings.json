{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp",
        "--headless",
        "--isolated",
        "--user-data-dir=/tmp/mcphub/browser-data"
      ]
    },
    "exa": {
      "type": "streamable-http",
      "url": "https://mcp.exa.ai/mcp?exaApiKey=${EXA_API_KEY}&tools=web_search_exa,get_code_context_exa,crawling_exa,company_research_exa,linkedin_search_exa,deep_researcher_start,deep_researcher_check"
    },
    "perplexity": {
      "command": "npx",
      "args": ["-y", "@perplexity-ai/mcp-server"],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"
      }
    },
    "deepwiki": {
      "type": "sse",
      "url": "https://mcp.deepwiki.com/sse"
    },
    "github": {
      "type": "streamable-http",
      "url": "https://api.githubcopilot.com/mcp",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}"
      }
    }
  },
  "systemConfig": {
    "routing": {
      "enableGlobalRoute": false,
      "enableGroupNameRoute": false
    },
    "install": {
      "baseUrl": "https://mcphubx.fly.dev"
    }
  },
  "groups": [
    {
      "name": "local",
      "description": "base tools for agents",
      "servers": [{ "name": "exa" }, { "name": "deepwiki" }]
    },
    {
      "name": "agent",
      "description": "with agentic headless browser and prefer the gh cli over github",
      "include": ["local"],
      "servers": [{ "name": "playwright" }]
    },
    {
      "name": "copilot",
      "description": "for GitHub Copilot agents (Projects V2 not built-in)",
      "include": ["local"],
      "servers": [
        {
          "name": "github",
          "headers": {
            "X-MCP-Toolsets": "projects"
          },
          "tools": [
            "add_project_item",
            "delete_project_item",
            "get_project",
            "get_project_field",
            "get_project_item",
            "list_project_fields",
            "list_project_items",
            "list_projects",
            "update_project_item"
          ]
        }
      ]
    }
  ]
}
