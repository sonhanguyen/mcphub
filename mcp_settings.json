{
  "mcpServers": {
    "playwright": {
      "command": "pnpx",
      "args": ["@playwright/mcp", "--headless", "--isolated", "--user-data-dir=/tmp/mcphub/browser-data"]
    },
    "perplexity": {
      "command": "pnpx",
      "args": ["-y", "@perplexity-ai/mcp-server"],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"
      }
    },
    "deepwiki": {
      "type": "sse",
      "url": "https://mcp.deepwiki.com/sse"
    },
    "context7": {
      "type": "streamable-http",
      "url": "https://mcp.context7.com/mcp"
    },
    "github": {
      "type": "streamable-http",
      "url": "https://api.githubcopilot.com/mcp",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}"
      }
    }
  },
  "systemConfig": {
    "routing": {
      "enableGlobalRoute": false,
      "enableGroupNameRoute": false
    },
    "install": {
      "baseUrl": "https://mcphubx.fly.dev"
    }
  },
  "groups": [
    {
      "name": "local",
      "description": "base tools for agents",
      "servers": [
        { "name": "perplexity" },
        { "name": "deepwiki" },
        { "name": "context7" }
      ]
    },
    {
      "name": "agent",
      "description": "with agentic headless browser and prefer the gh cli over github",
      "include": ["local"],
      "servers": [
        { "name": "playwright" }
      ]
    },
    {
      "name": "copilot",
      "description": "for GitHub Copilot agents (Projects V2 not built-in)",
      "include": ["local"],
      "servers": [
        {
          "name": "github",
          "headers": {
            "X-MCP-Toolsets": "projects"
          },
          "tools": [
            "add_project_item",
            "delete_project_item",
            "get_project",
            "get_project_field",
            "get_project_item",
            "list_project_fields",
            "list_project_items",
            "list_projects",
            "update_project_item"
          ]
        }
      ]
    }
  ]
}
