{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--headless"]
    },
    "perplexity": {
      "command": "npx",
      "args": ["-y", "@perplexity-ai/mcp-server@0.2.2"],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"
      }
    },
    "deepwiki": {
      "type": "sse",
      "url": "https://mcp.deepwiki.com/sse"
    },
    "context7": {
      "type": "streamable-http",
      "url": "https://mcp.context7.com/mcp"
    },
    "github": {
      "type": "streamable-http",
      "url": "https://api.githubcopilot.com/mcp",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}",
        "X-MCP-Toolsets": "default,projects"
      }
    }
  },
  "systemConfig": {
    "routing": {
      "enableGlobalRoute": false,
      "enableGroupNameRoute": false
    },
    "install": {
      "baseUrl": "http://localhost:3000"
    }
  },
  "groups": [
    {
      "name": "agent",
      "description": "base tools for agents",
      "servers": [
        { "name": "playwright" },
        { "name": "perplexity" },
        { "name": "deepwiki" },
        { "name": "context7" },
        { "name": "github" }
      ]
    },
    {
      "name": "copilot",
      "description": "for GitHub Copilot agents (Projects V2 not built-in)",
      "include": ["agent"],
      "servers": [
        {
          "name": "playwright",
          "enabled": false
        },
        {
          "name": "github",
          "tools": [
            "add_project_item",
            "delete_project_item",
            "get_project",
            "get_project_field",
            "get_project_item",
            "list_project_fields",
            "list_project_items",
            "list_projects",
            "update_project_item"
          ]
        }
      ]
    }
  ]
}
